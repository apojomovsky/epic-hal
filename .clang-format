# Brace-style gate config (scripts/brace-style-check.sh is the enforced
# checker: Allman braces on added lines, wired into the pre-commit hook,
# CI, and epic-tasks takeoff). This file exists so clang-format and the
# gate agree on the house style; it is not itself wired into a formatter
# pass (clang-format would also churn pre-existing code).
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 80
# House style is Allman/Microsoft: the opening brace owns its line, for
# function bodies and control statements alike.
BreakBeforeBraces: Allman
AlignConsecutiveDeclarations: false
AlignConsecutiveAssignments: false
SpaceBeforeParens: ControlStatements
PointerAlignment: Right
IndentCaseLabels: true
